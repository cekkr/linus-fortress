body{
background-color: #FEFEFE;

font-family: 'Roboto', sans-serif;
}

div{
padding:5px;
}

input{
  font-family: 'Roboto', sans-serif;
}

.body{
width:1024px;

margin-left:auto;
margin-right:auto;
}

.title{
border:1px solid black;

-webkit-border-top-left-radius: 5px;
-webkit-border-top-right-radius: 5px;
-moz-border-radius-topleft: 5px;
-moz-border-radius-topright: 5px;
border-top-left-radius: 5px;
border-top-right-radius: 5px;

background-color: white;

padding:0px;
padding-left:21px;
padding-top:5px;

font-size: 30px;
vertical-align:middle;

background: #cdeb8e; /* Old browsers */
background: -moz-linear-gradient(top,  #cdeb8e 0%, #a5c956 100%); /* FF3.6+ */
background: -webkit-gradient(linear, left top, left bottom, color-stop(0%,#cdeb8e), color-stop(100%,#a5c956)); /* Chrome,Safari4+ */
background: -webkit-linear-gradient(top,  #cdeb8e 0%,#a5c956 100%); /* Chrome10+,Safari5.1+ */
background: -o-linear-gradient(top,  #cdeb8e 0%,#a5c956 100%); /* Opera 11.10+ */
background: -ms-linear-gradient(top,  #cdeb8e 0%,#a5c956 100%); /* IE10+ */
background: linear-gradient(to bottom,  #cdeb8e 0%,#a5c956 100%); /* W3C */
filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#cdeb8e', endColorstr='#a5c956',GradientType=0 ); /* IE6-9 */

}

.nav{
border:1px solid black;

-webkit-border-bottom-right-radius: 5px;
-webkit-border-bottom-left-radius: 5px;
-moz-border-radius-bottomright: 5px;
-moz-border-radius-bottomleft: 5px;
border-bottom-right-radius: 5px;
border-bottom-left-radius: 5px;

background-image:url('image/fiber.jpg');

margin-bottom:5px;
padding:5px;
padding-left:5px;

color:white;

height:22px;
}

.whereNav{
background-color: black;
color: white;
padding:2px;
padding-left: 5px;
padding-right: 5px;
margin:4px;

-webkit-border-radius: 4px;
-moz-border-radius: 4px;
border-radius: 4px;

cursor:pointer;
}

.content
{
border:1px solid black;

-webkit-border-radius: 5px;
-moz-border-radius: 5px;
border-radius: 5px;

background-color: white;
}

/* inizio gestione menu */
.row{
display:table;
padding:1px;
padding-bottom:0px;
}

.appMoreInfo{
padding:0px;
margin:8px;
margin-top:0px;
margin-bottom:0px;

width:970px;
height:0px;

background-image:url('image/fiber.jpg');

opacity:0.0;
filter:alpha(opacity=0); /* For IE8 and earlier */

-webkit-border-radius: 2px;
-webkit-border-bottom-right-radius: 6px;
-webkit-border-bottom-left-radius: 6px;
-moz-border-radius: 2px;
-moz-border-radius-bottomright: 6px;
-moz-border-radius-bottomleft: 6px;
border-radius: 2px;
border-bottom-right-radius: 6px;
border-bottom-left-radius: 6px;

background-position:0px 69px;
}

.menuApp{
height:70px;
padding:2px;
padding-bottom:0px;

display:table-cell;
vertical-align:top;
}

.menuAppPre{
display:table;

-webkit-border-radius: 4px;
-moz-border-radius: 4px;
border-radius: 4px;

border:1px solid silver;

width:220px;

margin-bottom:5px;

background-color:#EEEEEE;
}

.menuAppIcon{
display:table-cell;
vertical-align:top;
border-collapse: collapse;
width:70px;

padding:0px;
padding-left:2px;
padding-right:5px;
}

.menuAppIcon img{
-webkit-border-radius: 5px;
-moz-border-radius: 5px;
border-radius: 5px; 
}

.inMoreInfoApp img{
-webkit-border-radius: 10px;
-moz-border-radius: 10px;
border-radius: 10px;
}

.menuAppTitleDescr{
display:table-cell;
vertical-align:top;
border-collapse: collapse;
width:186px;
padding:0px;
}

.menuAppTitle{
weight:bold;
padding:0px;
}

.menuAppDescription{
color:gray;
font-size:10px;
padding:0px;
}

/*
BLACK VERSION
*/

.menuAppPreBlack{
display:table;

-webkit-border-top-left-radius: 4px;
-webkit-border-top-right-radius: 4px;
-moz-border-radius-topleft: 4px;
-moz-border-radius-topright: 4px;
border-top-left-radius: 4px;
border-top-right-radius: 4px;

border-style: none;

width:220px;

background-image:url('image/fiber.jpg');

position:absolute;
top:5px;
left:5px;

opacity:0.0;
filter:alpha(opacity=0); /* For IE8 and earlier */

padding:6px;
padding-bottom:11px;

/*height:74px; for touch: 69px */

z-index:0;

cursor:pointer;
}

.menuAppTitleDescrBlack{
display:table-cell;
vertical-align:top;
border-collapse: collapse;
width:186px;
padding:0px;
}

.menuAppTitleBlack{
weight:bold;
padding:0px;

color:white;
}

.menuAppDescriptionBlack{
color:silver;
font-size:10px;
padding:0px;
}

/* fine gestione menu */

/* inizio gestione in more-info */
.inMoreInfoTable{
  display:table;
  margin-left:auto;
  margin-right:auto;
  
  padding: 10px;
}

.inMoreInfoTable h2, h3{
  text-shadow: -1px 0 black, 0 1px black, 1px 0 black, 0 -1px black;
  color:white;
  
  weight:bold;
  
  text-align:center;
  margin-left:auto; margin-right:auto;
  
  margin:0px;
}

.inMoreInfoApp{
  display:table-cell;
  vertical-align:top;
  width:200px;
  text-align:center;
  
  border-right-style: solid;
  border-right-color: gray;
  border-right-width:1px;
  
  padding: 5px;
}

.inMoreInfoSettings{
  display:table-cell;
  vertical-align:top;
  border-collapse: collapse;
  width:770px;
  color:white;
  
  padding: 10px;
}

.startButton, .deleteButton{
background-image:url('image/blurfiber.jpg'); 
border-style:none;
 
-webkit-border-radius: 5px;
-moz-border-radius: 5px;
border-radius: 5px;

border:1px solid gray;
padding:3px;

color: white;
text-shadow: -1px 0 black, 0 1px black, 1px 0 black, 0 -1px black;
}

.startButton{
 font-size:20px; 
}

.deleteButton{
 font-size:10px; 
}
/* fine gestione in more-info */

/*inizio login*/
.loginBox
{
height:500px;
width:500px;
margin-left:auto;
margin-right:auto;
}
