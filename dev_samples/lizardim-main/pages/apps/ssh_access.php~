function startSshOnce()
{
	if(!isset($_GLOBAL['pc_ssh']))
	{
		$_GLOBAL['pc_ssh'] = new Net_SSH2('127.0.0.1');
		$_GLOBAL['pc_ssh']->login('riccardo', 'cecchini');
	}

	return $_GLOBAL['pc_ssh'];
}

function isPacketInstalled($name)
{
	if(isset($_SESSION['packetIsInstalled_'.$name])) return $_SESSION['packetIsInstalled_'.$name];

	$ecco = startSshOnce();

	$out = $ecco->exec("apt-cache policy ". $name);
	$lines = explode("\n", $out);
	$val = explode(":", $out)[0];
	
	$ret = false;
	if(strpos($val, "(nessuno)")) $ret = true;
	
	$_SESSION['packetIsInstalled_'.$name] = $ret;
	return $ret;
}


